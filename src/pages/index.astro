---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { Image } from 'astro:assets';



// Exposiciones actuales (dos muestras simultáneas)
const exposiciones = {
    lugar: "Hotel Palacio de Merás",
    ubicacion: "Tineo, Asturias",
    fecha: "",
    videoId: "-RwfYSBFenc",
};

const vacuo = {
    titulo: "Vacuo",
    artista: "Lucas Santiago",
    descripcion: `Una exposición donde Lucas Santiago rescata objetos olvidados de pueblos abandonados para transformarlos en piezas de joyería contemporánea. Esta muestra invita a reflexionar sobre el vacío que dejan los lugares que un día fueron hogar.

A través de materiales como maderas, huesos, piedras y cuernos —todos ellos marcados por el paso del tiempo—, Santiago devuelve la vida a estos objetos, convirtiéndolos en joyas que guardan la memoria de quienes los usaron. El título "Vacuo" hace referencia a ese silencio de las aldeas abandonadas, espacios que aún conservan secretos y vivencias de sus antiguos habitantes.

"La reserva espiritual de nuestra sociedad está en los pueblos", reflexiona el artista. Esta exposición es un ejercicio de memoria colectiva, una forma de evitar que el folclore y la cultura rural caigan en el olvido.`
};

// Banner de exposición (busca primera imagen en src/assets/home)
const bannerFiles = import.meta.glob('/src/assets/home/*.{jpeg,jpg,png,webp}', { eager: true });
const bannerImage = Object.values(bannerFiles)[0] as any;
---

<Layout title="Lucas Santiago - Joyería Rural Contemporánea">
    <Navbar />



    <main class="relative z-10 pt-24 px-4 sm:px-8 max-w-6xl mx-auto pb-16">
        {/* Hero compacto */}
        <section class="mb-10 text-center py-6">
            <h1 class="text-5xl md:text-6xl font-light uppercase tracking-widest mb-12" style="font-family: 'Oswald', sans-serif; color: #9D7748;">
                Exposición actual
            </h1>

            {/* Banner con botón desplegable */}
            {bannerImage && (
                <div class="mb-16 text-center">
                    <button 
                        class="banner-toggle" 
                        data-target="banner-content"
                        aria-expanded="false"
                    >
                        <svg class="toggle-icon-eye" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        <span class="toggle-text">Ver cartel</span>
                        <svg class="toggle-icon-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <div id="banner-content" class="banner-content max-w-5xl mx-auto shadow-sm mt-4">
                         <Image 
                            src={bannerImage.default} 
                            alt="Banner Exposición" 
                            class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity duration-700"
                            width={1200}
                            loading="eager"
                         />
                    </div>
                </div>
            )}

            {/* Diseño Exposición Conjunta */}
            <div class="relative max-w-5xl mx-auto mb-16 pt-10 pb-6 border-t border-stone-200">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-stone-50 px-6 text-stone-400 text-xs md:text-sm tracking-[0.3em] uppercase whitespace-nowrap">
                    Exposición Conjunta
                </div>

                <div class="grid md:grid-cols-2 gap-8 items-center justify-center">
                    
                    {/* Lado Lucas */}
                    <div class="text-center group">
                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-normal uppercase tracking-widest mb-3 text-[#9D7748]" style="font-family: 'Oswald', sans-serif;">
                            {vacuo.titulo}
                        </h2>
                        <div class="flex items-center justify-center gap-3">
                            <span class="h-px w-8 bg-[#9D7748]"></span>
                            <h3 class="text-sm md:text-base text-stone-600 uppercase tracking-widest font-light">
                                {vacuo.artista}
                            </h3>
                            <span class="h-px w-8 bg-[#9D7748]"></span>
                        </div>
                    </div>

                    {/* Lado César */}
                    <div class="text-center group">
                        <h2 class="text-4xl md:text-5xl lg:text-6xl font-normal uppercase tracking-widest mb-3 text-stone-600 group-hover:text-[#9D7748] transition-colors duration-500" style="font-family: 'Oswald', sans-serif;">
                            A Fuego y Martillo
                        </h2>
                        <div class="flex items-center justify-center gap-3">
                            <span class="h-px w-8 bg-stone-300 group-hover:bg-[#9D7748] transition-colors duration-500"></span>
                            <h3 class="text-sm md:text-base text-stone-600 uppercase tracking-widest font-light">
                                César Castaño
                            </h3>
                            <span class="h-px w-8 bg-stone-300 group-hover:bg-[#9D7748] transition-colors duration-500"></span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="text-stone-600 font-light text-base md:text-lg tracking-wide mb-4">
                {exposiciones.lugar} · {exposiciones.ubicacion} · {exposiciones.fecha}
            </p>
            
            {/* Mapa desplegable */}
            <div class="text-center mb-16">
                 <button 
                    class="map-toggle inline-flex items-center gap-2 text-xs md:text-sm uppercase tracking-widest text-stone-400 hover:text-[#9D7748] transition-colors duration-300" 
                    data-target="map-content"
                    aria-expanded="false"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Ver ubicación en mapa</span>
                    <svg class="toggle-icon-arrow w-3 h-3 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div id="map-content" class="map-content max-w-5xl mx-auto mt-4 overflow-hidden transition-all duration-500 ease-in-out opacity-0 max-h-0">
                    <div id="map" class="w-full h-[400px] bg-stone-100 border border-stone-200 shadow-inner"></div>
                </div>
            </div>

            {/* Leaflet CSS */}
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        </section>

        {/* Grid: Vídeo + Descripción */}
        <section class="mb-10">
            <div class="grid lg:grid-cols-2 gap-8 items-start">
                {/* Vídeo */}
                <div class="video-container aspect-video w-full" data-video-id={exposiciones.videoId}>
                    <img
                        src={`https://img.youtube.com/vi/${exposiciones.videoId}/maxresdefault.jpg`}
                        alt="Vídeo de la exposición Vacuo"
                        class="video-thumbnail"
                        loading="lazy"
                    />
                    <button class="play-button" aria-label="Reproducir vídeo">
                        <svg viewBox="0 0 68 48" width="68" height="48">
                            <path d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z" fill="#212121" fill-opacity="0.8"></path>
                            <path d="M 45,24 27,14 27,34" fill="#fff"></path>
                        </svg>
                    </button>
                </div>

                {/* Descripción */}
                <div class="text-stone-700 font-light leading-relaxed text-sm md:text-base">
                    {vacuo.descripcion.split('\n\n').map((parrafo) => (
                        <p class="mb-4 last:mb-0">{parrafo}</p>
                    ))}
                </div>
            </div>
        </section>

        {/* Noticia destacada */}
        <section class="max-w-4xl mx-auto mb-16">
            <h2 class="text-center text-sm uppercase tracking-widest text-stone-400 mb-6">Mencionado en prensa</h2>
            
            <a href="https://www.lne.es/occidente/2025/11/11/palacio-asturiano-cumple-cinco-siglos-123567678.html" 
               target="_blank" 
               rel="noopener noreferrer"
               class="group flex gap-6 p-4 bg-white border border-stone-200 hover:border-stone-300 hover:shadow-md transition-all duration-300"
            >
                {/* Imagen */}
                <div class="w-32 h-24 sm:w-40 sm:h-28 flex-shrink-0 bg-stone-100 overflow-hidden">
                    <img 
                        src="https://estaticos-cdn.prensaiberica.es/clip/42f36011-3214-478e-af27-2b9574c7c35f_source-aspect-ratio_default_0.webp" 
                        alt="Palacio de Merás"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    />
                </div>

                {/* Contenido */}
                <div class="flex-1 min-w-0 flex flex-col justify-center">
                    <p class="text-xs text-[#9D7748] font-medium uppercase tracking-wide mb-2">
                        La Nueva España
                    </p>
                    <h3 class="text-lg text-stone-800 font-normal leading-snug group-hover:text-[#9D7748] transition-colors mb-2">
                        El palacio asturiano que cumple cinco siglos de vida
                    </h3>
                    <p class="text-sm text-stone-400">
                        11 nov 2025
                    </p>
                </div>

                {/* Flecha externa */}
                <div class="hidden sm:flex flex-shrink-0 self-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <svg class="w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                </div>
            </a>
        </section>

        {/* CTA */}
        <section class="text-center py-6 border-t border-stone-200">
            <a
                href="/contacto"
                class="cta-btn inline-block px-6 py-2 text-sm uppercase tracking-widest font-light transition-all duration-300"
            >
                Contactar
            </a>
        </section>
    </main>
</Layout>

<style>
    .cta-btn {
        border: 2px solid #9D7748;
        color: #9D7748;
    }

    .cta-btn:hover {
        background-color: #9D7748;
        color: white;
        border-color: #9D7748;
    }

    .video-container {
        position: relative;
        cursor: pointer;
        overflow: hidden;
        background-color: #000;
    }

    .video-thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.3s;
    }

    .video-container:hover .video-thumbnail {
        opacity: 0.85;
    }

    .play-button {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: none;
        border: none;
        cursor: pointer;
        transition: transform 0.2s, opacity 0.2s;
        opacity: 0.9;
    }

    .video-container:hover .play-button {
        transform: translate(-50%, -50%) scale(1.1);
        opacity: 1;
    }

    .play-button svg path:first-child {
        transition: fill-opacity 0.2s;
    }

    .video-container:hover .play-button svg path:first-child {
        fill: #9D7748;
        fill-opacity: 1;
    }

    .video-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100% !important;
        height: 100% !important;
        border: none;
        z-index: 10;
    }

    .video-container.playing {
        background-color: #000;
    }

    .video-container.playing .video-thumbnail,
    .video-container.playing .play-button {
        display: none;
    }

    /* Asegurar que aspect-video funciona con el iframe */
    .video-container.aspect-video {
        position: relative;
    }

    /* Estilos Toggle Banner (reutilizado con ajustes) */
    .banner-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: none;
        border: 1px solid #d6d3d1;
        border-radius: 2rem;
        padding: 0.5rem 1.2rem;
        cursor: pointer;
        color: #78716c;
        font-size: 0.85rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .banner-toggle:hover {
        color: #9D7748;
        border-color: #9D7748;
        background-color: rgba(157, 119, 72, 0.05);
    }

    .toggle-icon-eye {
        width: 1.1rem;
        height: 1.1rem;
    }

    .toggle-icon-arrow {
        width: 0.9rem;
        height: 0.9rem;
        transition: transform 0.4s ease;
        margin-left: 0.2rem;
    }

    .banner-toggle[aria-expanded="true"] .toggle-icon-arrow {
        transform: rotate(180deg);
    }

    .banner-content {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.8s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.6s ease;
    }

    .banner-content.expanded {
        max-height: 2000px; /* Suficiente para el cartel */
        opacity: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const videoContainers = document.querySelectorAll('.video-container');

        videoContainers.forEach(container => {
            container.addEventListener('click', () => {
                const videoId = container.getAttribute('data-video-id');
                if (!videoId) return;

                const iframe = document.createElement('iframe');
                // Parámetros para minimizar elementos de YouTube
                iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&showinfo=0&iv_load_policy=3&controls=1`;
                iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
                iframe.allowFullscreen = true;
                iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:none;';

                // Ocultar thumbnail y botón, añadir iframe
                const thumbnail = container.querySelector('.video-thumbnail');
                const playBtn = container.querySelector('.play-button');
                if (thumbnail) thumbnail.style.display = 'none';
                if (playBtn) playBtn.style.display = 'none';

                container.appendChild(iframe);
                container.style.cursor = 'default';
            });
        });

        // Lógica Toggle Banner
        const bannerToggle = document.querySelector('.banner-toggle');
        if (bannerToggle) {
            bannerToggle.addEventListener('click', () => {
                const targetId = bannerToggle.getAttribute('data-target');
                const content = document.getElementById(targetId);
                const isExpanded = bannerToggle.getAttribute('aria-expanded') === 'true';

                if (content) {
                    if (isExpanded) {
                        content.classList.remove('expanded');
                        bannerToggle.setAttribute('aria-expanded', 'false');
                    } else {
                        content.classList.add('expanded');
                        bannerToggle.setAttribute('aria-expanded', 'true');
                    }

                }
            });
        }

        // Lógica Toggle Mapa + Carga diferida de Leaflet
        const mapToggle = document.querySelector('.map-toggle');
        const mapContent = document.getElementById('map-content');
        let mapInitialized = false;

        if (mapToggle && mapContent) {
            mapToggle.addEventListener('click', async () => {
                const isExpanded = mapToggle.getAttribute('aria-expanded') === 'true';
                
                if (isExpanded) {
                    mapContent.style.maxHeight = '0';
                    mapContent.style.opacity = '0';
                    mapToggle.setAttribute('aria-expanded', 'false');
                } else {
                    mapContent.style.maxHeight = '400px';
                    mapContent.style.opacity = '1';
                    mapToggle.setAttribute('aria-expanded', 'true');

                    // Inicializar mapa solo la primera vez
                    if (!mapInitialized) {
                        const loadLeaflet = () => {
                            const map = L.map('map', {
                                scrollWheelZoom: true
                            }).setView([43.333612, -6.416713], 15);

                            // Capa CartoDB Positron (Gris/Minimalista) - GRATUITA
                            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                                attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
                                subdomains: 'abcd',
                                maxZoom: 20
                            }).addTo(map);

                            const tineoArea = {
                                "type": "Feature",
                                "properties": {
                                    "name": "Tineo Context"
                                },
                                "geometry": {
                                    "type": "Polygon",
                                    "coordinates": [[
                                        [-6.5, 43.4], [-6.3, 43.4], [-6.3, 43.2], [-6.5, 43.2], [-6.5, 43.4]
                                    ]]
                                }
                            };
                            
                            // Círculo para visualizar zona
                             L.circle([43.333612, -6.416713], {
                                color: '#9D7748',
                                fillColor: '#9D7748',
                                fillOpacity: 0.1,
                                radius: 500
                            }).addTo(map);

                            L.marker([43.333612, -6.416713]).addTo(map)
                                .bindPopup('<b>Hotel Palacio de Merás</b><br>Tineo, Asturias')
                                .openPopup();
                            
                            mapInitialized = true;
                        };

                        if (typeof L === 'undefined') {
                            const script = document.createElement('script');
                            script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
                            script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
                            script.crossOrigin = '';
                            script.onload = loadLeaflet;
                            document.head.appendChild(script);
                        } else {
                            loadLeaflet();
                        }
                    }
                }
            });
        }
    });
</script>
