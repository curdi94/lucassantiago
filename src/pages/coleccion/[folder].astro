---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { Image } from 'astro:assets';
import { collectionNames, collectionDescriptions, collectionPaths } from '../../config/collections.js';

// Importar datos de piezas por colección
import { vacuoPieces } from '../../config/pieces/vacuo.js';
import { vacasPieces } from '../../config/pieces/vacas.js';
import { galardonesPieces } from '../../config/pieces/galardones.js';
import { encargosPieces } from '../../config/pieces/encargos.js';

// Mapa de colección -> datos de piezas
const piecesData: Record<string, Record<string, { title: string; year: string; description: string; materials: string }>> = {
    vacuo: vacuoPieces,
    vacas: vacasPieces,
    galardones: galardonesPieces,
    encargos: encargosPieces,
};

// Importar todas las imágenes
const allImages = import.meta.glob('/src/assets/**/*.{jpg,jpeg,png,webp,PNG,JPG,JPEG}', { eager: true });

// Generar rutas estáticas para cada colección
export function getStaticPaths() {
    return collectionPaths;
}

const { folder } = Astro.params;
const collectionName = collectionNames[folder] || folder;
const collectionDescription = collectionDescriptions[folder] || '';

// Obtener datos de piezas para esta colección (si existen)
const currentPiecesData = piecesData[folder] || {};

// Helper para extraer nombre de archivo sin extensión
function getFileKey(path: string): string {
    const fileName = path.split('/').pop() || '';
    return fileName.replace(/\.[^.]+$/, '');
}

// Filtrar imágenes de esta colección y añadir metadata
const images = Object.entries(allImages)
    .filter(([path]) => {
        const parts = path.split('/');
        return parts[3] === folder;
    })
    .map(([path, img]) => {
        const fileKey = getFileKey(path);
        const pieceInfo = currentPiecesData[fileKey] || { title: '', year: '', description: '', materials: '' };
        return {
            image: (img as any).default,
            title: pieceInfo.title,
            year: pieceInfo.year,
            description: pieceInfo.description,
            materials: pieceInfo.materials
        };
    });
---

<Layout title={`${collectionName} - Colección`}>
    <Navbar />

    <main class="pt-24 px-4 sm:px-8 max-w-7xl mx-auto pb-16">
        <!-- Navegación -->
        <a href={`/colecciones#${folder}`} class="back-link">
            <svg class="back-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Volver a colecciones
        </a>

        <h1 class="text-4xl font-sans font-medium mb-4 tracking-widest uppercase" style="color: #9D7748; font-family: 'Oswald', sans-serif;">
            {collectionName}
        </h1>

        {collectionDescription && (
            <p class="text-stone-600 mb-6 max-w-3xl leading-relaxed italic">{collectionDescription}</p>
        )}

        <p class="text-stone-500 text-sm mb-12">{images.length} imágenes</p>

        <!-- Grid de imágenes -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
            {images.map((img, index) => (
                <article class="bg-white group overflow-hidden border border-stone-200 hover:border-stone-400 transition-all duration-300 hover:shadow-lg">
                    <div class="aspect-square relative overflow-hidden cursor-pointer" data-lightbox data-src={img.image.src}>
                        <Image
                            src={img.image}
                            alt={img.title || `${collectionName} - Pieza ${index + 1}`}
                            widths={[300, 600]}
                            sizes="(max-width: 600px) 300px, 600px"
                            loading="lazy"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                        />
                        {/* Overlay con lupa */}
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                            <svg class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                            </svg>
                        </div>
                    </div>
                    
                    {/* Información de la pieza - solo si tiene título, description, materials o year */}
                    {(img.title || img.description || img.materials || img.year) && (
                        <div class="piece-info">
                            {img.title && (
                                <h3 class="piece-title">{img.title}</h3>
                            )}
                            {img.description && (
                                <p class="piece-description">{img.description}</p>
                            )}
                            {img.materials && (
                                <p class="piece-materials">{img.materials}</p>
                            )}
                            {img.year && (
                                <p class="piece-year">{img.year}</p>
                            )}
                        </div>
                    )}
                </article>
            ))}
        </div>
    </main>
</Layout>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/90 flex items-center justify-center p-4">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-stone-300 transition-colors z-10">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
    <img id="lightbox-img" src="" alt="Imagen ampliada" class="max-w-full max-h-full object-contain" />
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('lightbox-close');

        // Abrir lightbox al hacer clic en imagen
        document.querySelectorAll('[data-lightbox]').forEach(el => {
            el.addEventListener('click', () => {
                const src = el.getAttribute('data-src');
                if (src && lightboxImg && lightbox) {
                    lightboxImg.src = src;
                    lightbox.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                }
            });
        });

        // Cerrar lightbox
        const closeLightbox = () => {
            if (lightbox) {
                lightbox.classList.add('hidden');
                document.body.style.overflow = '';
            }
        };

        closeBtn?.addEventListener('click', closeLightbox);
        lightbox?.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });

        // Cerrar con tecla Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        });
    });
</script>

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        color: #57534e;
        margin-bottom: 2rem;
        transition: color 0.2s;
        text-decoration: none;
    }

    .back-link:hover {
        color: #292524;
    }

    .back-icon {
        width: 1.25rem;
        height: 1.25rem;
        margin-right: 0.5rem;
    }

    /* Estilos para la información de las piezas */
    .piece-info {
        padding: 1.25rem 1rem;
        border-top: 1px solid #f5f5f4;
        background: linear-gradient(to bottom, #fafaf9, #ffffff);
    }

    .piece-title {
        font-family: 'Oswald', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        color: #44403c;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin: 0 0 0.5rem 0;
        line-height: 1.3;
    }

    .piece-description {
        font-size: 0.875rem;
        color: #78716c;
        line-height: 1.6;
        margin: 0;
        font-style: italic;
    }

    .piece-materials {
        font-size: 0.75rem;
        color: #a8a29e;
        line-height: 1.5;
        margin: 0.75rem 0 0 0;
        padding-top: 0.5rem;
        border-top: 1px solid #f5f5f4;
        letter-spacing: 0.02em;
    }

    .piece-year {
        font-size: 0.75rem;
        color: #9D7748;
        font-style: italic;
        margin: 0;
        text-align: right;
    }
</style>
